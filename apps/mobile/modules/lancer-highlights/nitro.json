{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["lancerhighlights"],
  "ios": {
    "iosModuleName": "LancerHighlightsNative"
  },
  "android": {
    "androidNamespace": ["lancerhighlights"],
    "androidCxxLibName": "lancerhighlights"
  },
  "autolinking": {
    "LancerHighlights": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridLancerHighlights"
      }
    }
  },
  "ignorePaths": ["node_modules", "Vendor"]
}
