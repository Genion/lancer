# Optional upstream T3 Connect service. Local Lancer Harness runs without cloud settings.
# Copy this file to .env and uncomment the public client settings below to opt in.
# Do not add server-side secrets to this file.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
# LANCER_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
# LANCER_CLERK_JWT_TEMPLATE=t3-relay
# LANCER_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in LANCER_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# LANCER_APPLE_TEAM_ID=ABC1234567
# LANCER_MACOS_PROVISIONING_PROFILE=/absolute/path/to/lancer.provisionprofile
# LANCER_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
# LANCER_RELAY_URL=https://relay.t3.codes

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.t3.codes; override to test against a staging deployment.
# LANCER_HOSTED_APP_URL=https://nightly.app.t3.codes

# Public, ingest-only mobile OpenTelemetry configuration.
# LANCER_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# LANCER_MOBILE_OTLP_TRACES_DATASET=lancer-harness-mobile-traces-dev
# LANCER_MOBILE_OTLP_TRACES_TOKEN=xaat-...
